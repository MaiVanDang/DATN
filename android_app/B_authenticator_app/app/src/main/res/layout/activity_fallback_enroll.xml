<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đăng ký mẫu lắc cá nhân"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginBottom="8dp"
            android:max="3"
            android:progress="0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="App sẽ học cách bạn lắc điện thoại để dùng làm xác thực dự phòng. Hãy lắc theo nhịp tự nhiên của bạn (không cần đếm số lần cụ thể). Lặp lại 3 lần."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="28dp" />

        <ProgressBar
            android:id="@+id/feProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginBottom="8dp"
            android:max="3"
            android:progress="0" />

        <TextView
            android:id="@+id/feTrialStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:text="Bấm 'Bắt đầu lắc', lắc theo nhịp tự nhiên của bạn, rồi bấm 'Xong lắc'." />

        <TextView
            android:id="@+id/feCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="72sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/feBtnShake"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Bắt đầu lắc"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
