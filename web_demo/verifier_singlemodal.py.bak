"""
verifier.py — Lõi xác thực (phiên bản cos_znorm đơn modal).

Khớp ĐÚNG với bản triển khai trên app:
  embedding (CNN 1D) → mean cosine tới anchor của chủ máy
  → chuẩn hóa cohort z-norm → sigmoid → so ngưỡng.

KHÔNG dùng Random Forest, KHÔNG fusion touch (đó là hướng cũ / đối chứng).
Chống rò rỉ: cohort impostor loại trừ owner; enroll và test tách phiên.
"""
import json
import numpy as np
import torch
from pathlib import Path
from sklearn.metrics import roc_curve


# ═══════════════════════════════════════════════════════════════════
# Artifacts (chỉ cần impostor pool inertial cho z-norm)
# ═══════════════════════════════════════════════════════════════════

class Artifacts:
    def __init__(self, pool_inertial: np.ndarray):
        self.pool_inertial = pool_inertial


def load_artifacts(export_dir: Path) -> Artifacts:
    export_dir = Path(export_dir)
    pool_i = np.load(export_dir / "impostor_pool_inertial.npy")
    assert pool_i.shape[1] == 128, f"Pool inertial dim {pool_i.shape[1]} != 128"
    return Artifacts(pool_inertial=pool_i.astype(np.float32))


# ═══════════════════════════════════════════════════════════════════
# Data loading
# ═══════════════════════════════════════════════════════════════════

_FILE_BY_MODE = {
    'walking': ('X_walking.npy', 'y_walking.npy'),
    'all':     ('X_inertial.npy', 'y_inertial.npy'),
}


def list_available_users(data_dir: Path) -> list:
    if not Path(data_dir).exists():
        return []
    users = []
    for d in sorted(Path(data_dir).iterdir()):
        if d.is_dir() and (
            (d / 'X_inertial.npy').exists() or (d / 'X_walking.npy').exists()
        ):
            users.append(d.name)
    return users


def load_user_inertial(user_id: str, data_dir: Path, mode: str = 'walking') -> dict:
    user_dir = Path(data_dir) / user_id
    x_name, y_name = _FILE_BY_MODE.get(mode, _FILE_BY_MODE['walking'])
    x_path = user_dir / x_name
    y_path = user_dir / y_name
    if not x_path.exists():
        alt_x, alt_y = _FILE_BY_MODE['all' if mode == 'walking' else 'walking']
        x_path = user_dir / alt_x
        y_path = user_dir / alt_y
        if not x_path.exists():
            return {}
    X = np.load(x_path)
    sess = np.load(y_path, allow_pickle=True)
    sessions = {}
    prefix = f"{user_id}_"
    for s in np.unique(sess):
        s_str = str(s)
        key = s_str[len(prefix):] if s_str.startswith(prefix) else s_str
        sessions[key] = X[sess == s].astype(np.float32)
    return sessions


def normalize_window_layout(windows: np.ndarray) -> np.ndarray:
    if windows.ndim != 3:
        raise ValueError(f"Expected 3D, got {windows.shape}")
    if windows.shape[2] == 9:          # (N, T, 9) → (N, 9, T)
        windows = windows.transpose(0, 2, 1)
    elif windows.shape[1] == 9:
        pass
    else:
        raise ValueError(f"Unexpected window shape {windows.shape}")
    return windows.astype(np.float32)


def zscore_per_window(windows: np.ndarray, eps: float = 1e-8) -> np.ndarray:
    mean = windows.mean(axis=2, keepdims=True)
    std = windows.std(axis=2, keepdims=True)
    return (windows - mean) / (std + eps)


def extract_embeddings(encoder: torch.nn.Module, windows: np.ndarray) -> np.ndarray:
    """(N, *, *) → (N, 128). Chuẩn hóa per-window GIỐNG app trước khi vào backbone."""
    windows = zscore_per_window(normalize_window_layout(windows))
    with torch.no_grad():
        emb = encoder(torch.from_numpy(windows)).numpy()
    return emb


# ═══════════════════════════════════════════════════════════════════
# Scoring — cos_znorm (khớp app)
# ═══════════════════════════════════════════════════════════════════

def _l2(M: np.ndarray) -> np.ndarray:
    return M / (np.linalg.norm(M, axis=-1, keepdims=True) + 1e-9)


def mean_cosine(embeds: np.ndarray, anchors: np.ndarray) -> np.ndarray:
    """Mỗi embedding → trung bình cosine tới toàn bộ anchor. Trả (N,)."""
    return (_l2(embeds) @ _l2(anchors).T).mean(1)


def sigmoid(x: np.ndarray) -> np.ndarray:
    return 1.0 / (1.0 + np.exp(-x))


# Hằng số sigmoid cho thang z-norm (khớp giá trị khởi đầu bên app; tinh chỉnh nếu cần)
SCORE_SCALE = 3.0
SCORE_BIAS  = 2.0


def fit_cohort(anchors: np.ndarray, pool: np.ndarray) -> tuple[float, float]:
    """ZNORM: (mean,std) của điểm mean-cosine mà anchor tạo ra trên cohort impostor."""
    if len(anchors) == 0 or len(pool) == 0:
        return 0.0, 1.0
    s = mean_cosine(pool, anchors)
    return float(s.mean()), float(s.std() + 1e-9)


def score_windows(embeds: np.ndarray, anchors: np.ndarray,
                  cohort_mean: float, cohort_std: float) -> np.ndarray:
    """Trả điểm tin cậy [0,1] cho từng cửa sổ (cos_znorm → sigmoid)."""
    raw = mean_cosine(embeds, anchors)
    z = (raw - cohort_mean) / cohort_std if cohort_std > 1e-6 else raw
    return sigmoid(SCORE_SCALE * (z - SCORE_BIAS))


# ═══════════════════════════════════════════════════════════════════
# Enrollment
# ═══════════════════════════════════════════════════════════════════

class Enrollment:
    def __init__(self, owner_id, enroll_sessions, anchors,
                 cohort_mean, cohort_std, threshold, data_mode):
        self.owner_id = owner_id
        self.enroll_sessions = enroll_sessions
        self.anchors = anchors
        self.cohort_mean = cohort_mean
        self.cohort_std = cohort_std
        self.threshold = threshold
        self.data_mode = data_mode


def _build_cohort(owner_id, impostor_dir, encoder, artifacts, data_mode, seed=42):
    """Embedding của tất cả user TRỪ owner (loại rò rỉ). Fallback pool pre-built."""
    embeds = []
    for ud in sorted(Path(impostor_dir).iterdir()):
        if not ud.is_dir() or ud.name == owner_id:
            continue
        try:
            for w in load_user_inertial(ud.name, impostor_dir, mode=data_mode).values():
                if len(w):
                    embeds.append(extract_embeddings(encoder, w))
        except Exception:
            continue
    if not embeds:
        return artifacts.pool_inertial
    arr = np.concatenate(embeds, 0)
    cap = max(len(artifacts.pool_inertial), 100)
    if len(arr) > cap:
        rng = np.random.default_rng(seed)
        arr = arr[rng.choice(len(arr), cap, replace=False)]
    return arr.astype(np.float32)


def enroll(owner_id, n_enroll_sessions, data_dir, encoder, artifacts,
           data_mode='walking', seed=42, impostor_dir=None) -> Enrollment:
    """Tạo hồ sơ: anchor (từ enroll sessions) + cohort (mean,std) + ngưỡng EER."""
    if impostor_dir is None:
        impostor_dir = data_dir

    sessions = load_user_inertial(owner_id, data_dir, mode=data_mode)
    keys = sorted(sessions.keys())
    enroll_keys = keys[:n_enroll_sessions]
    if len(enroll_keys) < n_enroll_sessions:
        raise ValueError(f"{owner_id} chỉ có {len(keys)} session; cần {n_enroll_sessions}")

    # Tách 1 session làm val để đặt ngưỡng (nếu đủ ≥2 session enroll)
    if len(enroll_keys) >= 2:
        anchor_keys, val_key = enroll_keys[:-1], enroll_keys[-1]
    else:
        anchor_keys, val_key = enroll_keys, None

    anchor_windows = np.concatenate([sessions[s] for s in anchor_keys], 0)
    anchors = extract_embeddings(encoder, anchor_windows)

    cohort = _build_cohort(owner_id, impostor_dir, encoder, artifacts, data_mode, seed)
    cohort_mean, cohort_std = fit_cohort(anchors, cohort)

    threshold = _tune_threshold(
        owner_id, val_key, data_dir, encoder, anchors,
        cohort_mean, cohort_std, impostor_dir, data_mode,
    )
    return Enrollment(owner_id, enroll_keys, anchors,
                      cohort_mean, cohort_std, threshold, data_mode)


def _tune_threshold(owner_id, val_key, data_dir, encoder, anchors,
                    cohort_mean, cohort_std, impostor_dir, data_mode) -> float:
    """Ngưỡng tại điểm EER trên val: val session của owner (+) vs 1 session mỗi user khác (-)."""
    if val_key is None:
        return 0.5
    scores, labels = [], []

    own = load_user_inertial(owner_id, data_dir, mode=data_mode)
    if val_key in own and len(own[val_key]):
        s = score_windows(extract_embeddings(encoder, own[val_key]),
                           anchors, cohort_mean, cohort_std)
        scores.extend(s.tolist()); labels.extend([1] * len(s))

    for u in list_available_users(impostor_dir):
        if u == owner_id:
            continue
        try:
            us = load_user_inertial(u, impostor_dir, mode=data_mode)
        except Exception:
            continue
        if not us:
            continue
        sid = sorted(us.keys())[0]
        s = score_windows(extract_embeddings(encoder, us[sid]),
                           anchors, cohort_mean, cohort_std)
        scores.extend(s.tolist()); labels.extend([0] * len(s))

    y = np.array(labels); sc = np.array(scores)
    if len(np.unique(y)) < 2:
        return 0.5
    fpr, tpr, thr = roc_curve(y, sc)
    eer_idx = int(np.argmin(np.abs(fpr - (1 - tpr))))
    return float(np.clip(thr[eer_idx], 0.0, 1.0))


# ═══════════════════════════════════════════════════════════════════
# Verification (mức phiên)
# ═══════════════════════════════════════════════════════════════════

def verify_session(enrollment: Enrollment, test_user_id: str,
                   test_session_id: str, data_dir: Path,
                   encoder: torch.nn.Module) -> dict:
    sessions = load_user_inertial(test_user_id, data_dir, mode=enrollment.data_mode)
    is_owner = (test_user_id == enrollment.owner_id)
    if test_session_id not in sessions or len(sessions[test_session_id]) == 0:
        return {'test_user': test_user_id, 'session': test_session_id,
                'is_actual_owner': is_owner, 'score': None,
                'decision': 'NO_DATA', 'n_windows': 0, 'correct': False}

    windows = sessions[test_session_id]
    per_window = score_windows(extract_embeddings(encoder, windows),
                               enrollment.anchors,
                               enrollment.cohort_mean, enrollment.cohort_std)
    score = float(per_window.mean())          # mức phiên = trung bình các cửa sổ
    decision = 'TRUSTED' if score >= enrollment.threshold else 'REJECTED'
    return {
        'test_user': test_user_id,
        'session': test_session_id,
        'is_actual_owner': is_owner,
        'score': score,
        'decision': decision,
        'correct': (decision == 'TRUSTED' if is_owner else decision == 'REJECTED'),
        'n_windows': len(windows),
    }
