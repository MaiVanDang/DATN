"""
app.py — Active Auth Demo (gọn, đơn modal cos_znorm)

Mô phỏng ĐÚNG đường quyết định trên app:
  embedding (CNN 1D) → mean cosine tới anchor → z-norm cohort → sigmoid → ngưỡng.

Luồng demo:
  1) Chọn chủ máy + số session enroll  → Enroll
  2) Chấm điểm: chủ máy (session test) vs người lạ → TRUSTED / REJECTED
Hiển thị tối giản: điểm tin cậy, quyết định, đúng/sai. Không bảng phân tích sâu.

Chạy:  streamlit run app.py
"""
from pathlib import Path

import numpy as np
import pandas as pd
import streamlit as st

from models import load_encoder
from verifier import (
    list_available_users, load_user_inertial,
    enroll, verify_session, load_artifacts,
)

# ─────────────────────────────────────────────────────────────
# Cấu hình mặc định: bản triển khai = CNN 1D, mode all
# ─────────────────────────────────────────────────────────────
ARTIFACTS_ROOT = Path("artifacts")
ARCH       = "cnn"
ARCH_DIR   = "cnn_v2"
N_USERS    = 19

MODE_LABEL = {"walking": "Đi bộ", "all": "Toàn bộ hoạt động"}

st.set_page_config(page_title="Active Auth Demo", page_icon="🔐", layout="centered")
st.title("🔐 Demo xác thực hành vi liên tục")
st.caption("Mô phỏng đường quyết định on-device: embedding → cosine tới anchor "
           "→ chuẩn hóa cohort (z-norm) → điểm tin cậy → quyết định.")


@st.cache_resource
def get_encoder(ckpt: str):
    return load_encoder(ckpt, n_users=N_USERS, arch=ARCH)


@st.cache_resource
def get_artifacts(export_dir: str):
    return load_artifacts(Path(export_dir))


def decision_badge(decision: str, is_owner: bool):
    correct = (decision == "TRUSTED") == is_owner
    icon = "✅" if correct else "❌"
    color = {"TRUSTED": "green", "REJECTED": "red", "NO_DATA": "gray"}.get(decision, "gray")
    st.markdown(f"{icon} :{color}[**{decision}**]")


# ─────────────────────────────────────────────────────────────
# Sidebar — cấu hình + enroll
# ─────────────────────────────────────────────────────────────
with st.sidebar:
    st.header("⚙️ Cấu hình")

    data_dir = Path(st.text_input("Thư mục dữ liệu", value="processed_data"))
    mode = st.radio("Ngữ cảnh", ["all", "walking"],
                    format_func=lambda m: MODE_LABEL[m], index=0)

    paths_export = ARTIFACTS_ROOT / ARCH_DIR / f"export_{mode}"
    paths_ckpt   = ARTIFACTS_ROOT / ARCH_DIR / f"models_{mode}" / "backbone.pt"

    users = list_available_users(data_dir)
    if not users:
        st.error(f"Không thấy user nào trong `{data_dir}`. "
                 "Mỗi user là một thư mục có X_inertial.npy / X_walking.npy.")
        st.stop()
    st.success(f"✓ {len(users)} user")

    encoder = get_encoder(str(paths_ckpt))
    artifacts = get_artifacts(str(paths_export))

    st.divider()
    st.header("👤 Đăng ký chủ máy")
    owner_id = st.selectbox("Chủ máy", users, index=0)

    n_sess = len(load_user_inertial(owner_id, data_dir, mode=mode))
    n_enroll = st.slider("Số session để enroll", 1, max(1, n_sess),
                         min(2, n_sess))

    if st.button("🎯 Đăng ký", type="primary", use_container_width=True):
        with st.spinner("Đang tạo hồ sơ chủ máy..."):
            try:
                enr = enroll(owner_id, n_enroll, data_dir, encoder, artifacts,
                             data_mode=mode)
                st.session_state["enr"] = enr
                st.session_state["enr_users"] = users
                st.session_state["enr_dir"] = str(data_dir)
                st.success(f"✓ Đã đăng ký `{owner_id}` "
                           f"({len(enr.anchors)} anchor, ngưỡng={enr.threshold:.2f})")
            except Exception as e:
                st.error(f"Đăng ký thất bại: {e}")


# ─────────────────────────────────────────────────────────────
# Main — demo chấm điểm
# ─────────────────────────────────────────────────────────────
enr = st.session_state.get("enr")
if enr is None:
    st.info("⬅️ Chọn chủ máy và bấm **Đăng ký** ở thanh bên để bắt đầu.")
    st.stop()

st.subheader(f"Chủ máy đã đăng ký: `{enr.owner_id}`")
c1, c2, c3 = st.columns(3)
c1.metric("Anchor", len(enr.anchors))
c2.metric("Ngưỡng quyết định", f"{enr.threshold:.2f}")
c3.metric("Ngữ cảnh", MODE_LABEL[enr.data_mode])

st.divider()
st.subheader("So sánh: Chủ máy vs Người lạ")

users = st.session_state["enr_users"]
data_dir = Path(st.session_state["enr_dir"])
others = [u for u in users if u != enr.owner_id]

colL, colR = st.columns(2)

with colL:
    st.markdown("#### 🟢 Chủ máy")
    own_sessions = sorted(load_user_inertial(enr.owner_id, data_dir, mode=enr.data_mode).keys())
    # gợi ý: chọn session KHÔNG nằm trong enroll
    test_candidates = [s for s in own_sessions if s not in enr.enroll_sessions] or own_sessions
    own_sid = st.selectbox("Session test của chủ máy", test_candidates)
    if own_sid in enr.enroll_sessions:
        st.warning("⚠ Session này nằm trong tập enroll — nên chọn session khác để công bằng.")
    if st.button("Chấm điểm chủ máy", use_container_width=True):
        r = verify_session(enr, enr.owner_id, own_sid, data_dir, encoder)
        if r["score"] is not None:
            st.metric("Điểm tin cậy", f"{r['score']:.2f}")
            st.progress(min(max(r["score"], 0.0), 1.0))
            decision_badge(r["decision"], True)
        else:
            st.warning("Session không có dữ liệu.")

with colR:
    st.markdown("#### 🔴 Người lạ")
    stranger = st.selectbox("Người lạ", others)
    str_sessions = sorted(load_user_inertial(stranger, data_dir, mode=enr.data_mode).keys())
    str_sid = st.selectbox("Session của người lạ", str_sessions)
    if st.button("Chấm điểm người lạ", use_container_width=True):
        r = verify_session(enr, stranger, str_sid, data_dir, encoder)
        if r["score"] is not None:
            st.metric("Điểm tin cậy", f"{r['score']:.2f}")
            st.progress(min(max(r["score"], 0.0), 1.0))
            decision_badge(r["decision"], False)
        else:
            st.warning("Session không có dữ liệu.")

st.divider()

# ─────────────────────────────────────────────────────────────
# Quét nhanh tất cả người lạ (1 session/người) — bảng gọn
# ─────────────────────────────────────────────────────────────
with st.expander("📊 Quét nhanh tất cả người lạ (1 session/người)"):
    if st.button("Chạy quét", use_container_width=True):
        rows = []
        # chủ máy: các session test
        for s in test_candidates:
            r = verify_session(enr, enr.owner_id, s, data_dir, encoder)
            if r["score"] is not None:
                rows.append({"Người": enr.owner_id + " (chủ)", "Session": s,
                             "Điểm": round(r["score"], 3), "Quyết định": r["decision"],
                             "Đúng?": "✓" if r["correct"] else "✗"})
        # người lạ
        for u in others:
            sess = sorted(load_user_inertial(u, data_dir, mode=enr.data_mode).keys())
            if not sess:
                continue
            r = verify_session(enr, u, sess[0], data_dir, encoder)
            if r["score"] is not None:
                rows.append({"Người": u, "Session": sess[0],
                             "Điểm": round(r["score"], 3), "Quyết định": r["decision"],
                             "Đúng?": "✓" if r["correct"] else "✗"})
        if rows:
            df = pd.DataFrame(rows)
            st.dataframe(df, use_container_width=True, hide_index=True)
            acc = (df["Đúng?"] == "✓").mean()
            st.caption(f"Độ chính xác quyết định: {acc*100:.0f}% "
                       f"(ngưỡng={enr.threshold:.2f}, mức phiên)")
